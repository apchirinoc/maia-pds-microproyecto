# Copiar a .env. Generar secretos propios; no publicar este archivo con valores reales.
POSTGRES_PASSWORD=
JWT_SECRET=
WEB_PORT=8080
API_PORT=8000
WEB_ORIGIN=http://localhost:8080
PUBLIC_API_URL=http://localhost:8000

# Paquete portable MLflow en artifacts/classifier/MLmodel y sus archivos.
# MLflow remoto puede estar apagado cuando se sirve este paquete.
MODEL_DIRECTORY=./artifacts
MLFLOW_MODEL_URI=/models/classifier
MLFLOW_MODEL_NAME=ResNet18v1
MLFLOW_MODEL_VERSION=
EXPECTED_PREPROCESS_FINGERPRINT=3550069770ff4bc4

# El logged model PyTorch de origen debe convertirse primero siguiendo
# ml_project/ENTREGA_RESNET18V1.md; la API recibe el paquete pyfunc ONNX completo.

# Alternativa: dejar MLFLOW_MODEL_URI vacío y resolver un paquete pyfunc convertido
# del registro. En ese caso configurar su nombre y versión, no el PyTorch original.
MLFLOW_TRACKING_URI=
