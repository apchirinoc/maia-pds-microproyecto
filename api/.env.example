# ==============================================================================
# BrainNeuroScan API - Variables de Entorno (.env.example)
# ==============================================================================

# Entorno de ejecución: 'development', 'staging' o 'production'
ENVIRONMENT=development
DEBUG=true

# Red y Puerto (En plataformas como Railway, PORT es asignado dinámicamente)
HOST=0.0.0.0
PORT=8000

# Orígenes permitidos para CORS (separados por coma, o '*' para permitir cualquier origen)
# Ejemplo: http://localhost:5173,https://mi-frontend.railway.app
ALLOWED_ORIGINS=http://localhost:5173

# Seguridad y Autenticación JWT
# NOTA: En producción (ENVIRONMENT=production), la API rechazará el valor por defecto.
JWT_SECRET=cambia-este-secreto-en-produccion-por-un-hash-seguro
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15

# Credenciales de usuario demo
DEMO_USERNAME=demo
DEMO_PASSWORD=demo

# Origen de Datos:
# - 'seed': Datos simulados en memoria (no requiere base de datos para arrancar)
# - 'postgres': Conexión real a base de datos PostgreSQL / Supabase
DATA_SOURCE=seed

# Opción A: Cadena de conexión completa a PostgreSQL (soporta postgresql://, postgres://, sslmode, etc.)
# Ejemplo Supabase: postgresql://postgres:MI_PASSWORD@db.szfjcrtnxtmefukjakbz.supabase.co:5432/postgres
# Ejemplo Railway: postgresql://postgres:MI_PASSWORD@roundhouse.proxy.rlwy.net:12345/railway
DATABASE_URL=

# Opción B: Variables discretas de PostgreSQL (usadas si DATABASE_URL está vacía)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=postgres
# Modo SSL: 'require' para Supabase / Cloud Postgres, o 'disable' para Docker local
POSTGRES_SSL=require

# Motor de Inferencia de ML:
# - 'simulated': Respuestas simuladas con lógica probabilística de investigación
# - 'onnx': Modelo real cargado vía ONNX Runtime
INFERENCE_ENGINE=simulated

# Configuración MLflow (Opcional, para registro y tracking de modelos)
MLFLOW_TRACKING_URI=
MLFLOW_MODEL_NAME=brain-tumor-classifier
MLFLOW_MODEL_ALIAS=champion

# Configuración AWS S3 / MinIO (Opcional, para artefactos de MLflow)
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
MLFLOW_S3_ENDPOINT_URL=

# Paquete local o URI MLflow. Si está vacío se resuelve versión/alias del registro.
MLFLOW_MODEL_URI=
MLFLOW_MODEL_VERSION=
EXPECTED_PREPROCESS_FINGERPRINT=
INFERENCE_CONCURRENCY=2
