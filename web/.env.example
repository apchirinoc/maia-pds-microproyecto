# ==============================================================================
# BrainNeuroScan Web SPA - Variables de Entorno (.env.example)
# ==============================================================================

# URL base del API de backend:
# En desarrollo local: http://localhost:8000
# En despliegue (Railway/Render/Docker): URL pública de tu API desplegada, p.ej. https://api-production-xxxx.up.railway.app
# En Docker, también puedes pasarla simplemente como API_URL o VITE_API_BASE_URL en tiempo de ejecución.
VITE_API_BASE_URL=http://localhost:8000

# Forzar mocks en frontend:
# - 'false': Consume el API real
# - 'true': Simula todas las peticiones con datos mock en el cliente
VITE_FORCE_MOCKS=false

# Timeouts y sondeo del estado de salud del API (en milisegundos):
VITE_API_TIMEOUT_MS=6000
VITE_HEALTH_TIMEOUT_MS=2500
VITE_HEALTH_POLL_MS=30000

# Puerto del servidor web (utilizado dentro del contenedor Docker / Nginx)
# En plataformas como Railway o Render, este valor es inyectado dinámicamente.
PORT=80
